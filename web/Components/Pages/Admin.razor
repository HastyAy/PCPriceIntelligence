@page "/admin/scraper"
@using Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using web.Services
@using web.Services.Scrapers
@inject IComponentScraperService ScraperService
@inject ComponentUpsertService UpsertService
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Admin - Scraper Control</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="container-fluid py-4">
            <div class="row mb-4">
                <div class="col">
                    <h1 class="display-5">
                        <i class="bi bi-cloud-download"></i> Scraper Control Panel
                    </h1>
                    <p class="text-muted">Manually trigger component scraping and view statistics</p>
                </div>
            </div>

            <!-- Status Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h6 class="card-title">Total Scraped</h6>
                            <h2 class="mb-0">@totalScraped</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h6 class="card-title">New Added</h6>
                            <h2 class="mb-0">@totalAdded</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h6 class="card-title">Updated</h6>
                            <h2 class="mb-0">@totalUpdated</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body">
                            <h6 class="card-title">Status</h6>
                            <h2 class="mb-0">@(isScraperRunning ? "Running" : "Idle")</h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scrape All Button -->
            <div class="row mb-4">
                <div class="col">
                    <div class="card">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0">Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <button class="btn btn-lg btn-success"
                                    @onclick="ScrapeAllCategories"
                                    disabled="@isScraperRunning">
                                @if (isScraperRunning)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-lightning-fill"></i> Scrape All Categories
                            </button>
                            <small class="text-muted d-block mt-2">
                                This will scrape all component categories (CPU, GPU, RAM, etc.)
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Individual Category Scraping -->
            <div class="row">
                <div class="col">
                    <div class="card">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0">Scrape Individual Categories</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @foreach (var category in categories)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 @(GetCategoryStatus(category) == "running" ? "border-primary" : "")">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-3">
                                                    <div>
                                                        <h6 class="card-title mb-1">@category</h6>
                                                        <small class="text-muted">
                                                            @GetCategoryIcon(category)
                                                        </small>
                                                    </div>
                                                    @if (GetCategoryStatus(category) == "running")
                                                    {
                                                        <span class="spinner-border spinner-border-sm text-primary"></span>
                                                    }
                                                </div>

                                                @if (categoryResults.ContainsKey(category))
                                                {
                                                    var result = categoryResults[category];
                                                    <div class="mb-2">
                                                        <small class="text-success">✓ Scraped: @result.scraped</small><br />
                                                        <small class="text-info">+ Added: @result.added</small><br />
                                                        <small class="text-warning">⟳ Updated: @result.updated</small>
                                                    </div>
                                                }

                                                <button class="btn btn-sm btn-outline-primary w-100"
                                                        @onclick="() => ScrapeCategory(category)"
                                                        disabled="@(isScraperRunning || GetCategoryStatus(category) == "running")">
                                                    <i class="bi bi-download"></i> Scrape @category
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Logs -->
            @if (logs.Any())
            {
                <div class="row mt-4">
                    <div class="col">
                        <div class="card">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Activity Log</h5>
                                <button class="btn btn-sm btn-outline-light" @onclick="ClearLogs">
                                    Clear Logs
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="log-container" style="max-height: 400px; overflow-y: auto;">
                                    @foreach (var log in logs.OrderByDescending(l => l.timestamp))
                                    {
                                        <div class="log-entry mb-2 p-2 rounded @GetLogClass(log.level)">
                                            <small class="text-muted">@log.timestamp.ToString("HH:mm:ss")</small>
                                            <span class="ms-2">@log.message</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5">
            <div class="alert alert-danger">
                <h4 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill"></i> Access Denied
                </h4>
                <p>You do not have permission to access this page.</p>
                <p class="mb-0">This page is restricted to administrators only.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .log-entry {
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        border-left: 3px solid #dee2e6;
    }

    .log-info {
        background-color: #e7f3ff;
        border-left-color: #0d6efd;
    }

    .log-success {
        background-color: #d1f2eb;
        border-left-color: #198754;
    }

    .log-warning {
        background-color: #fff3cd;
        border-left-color: #ffc107;
    }

    .log-error {
        background-color: #f8d7da;
        border-left-color: #dc3545;
    }

    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
</style>

