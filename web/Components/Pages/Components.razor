@page "/components"
@using Domain.Entities
@using Domain.Enums
@using web.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

<PageTitle>PC Components - Price Comparison</PageTitle>

<h3>PC Components Price</h3>

<div class="row mb-3">
    <div class="col-md-4">
        <label>Filter by Type:</label>
        <select class="form-select" @onchange="FilterByType">
            <option value="">All Components</option>
            @foreach (var type in Enum.GetValues<ComponentType>())
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label>Filter by Manufacturer:</label>
        <select class="form-select" @onchange="FilterByManufacturer">
            <option value="">All Manufacturers</option>
            @foreach (var manu in Enum.GetValues<Manufacturer>())
            {
                <option value="@manu">@manu</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label>Search:</label>
        <input type="text" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Search components..." />
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!filteredComponents.Any())
{
    <div class="alert alert-info">
        No components found. Run the app to seed sample data.
    </div>
}
else
{
    <div class="row">
        @foreach (var component in filteredComponents)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(component.ImageUrl))
                    {
                        <div class="card-img-wrapper">
                            <img src="@component.ImageUrl" class="card-img-top component-img" alt="@component.Name" />
                        </div>
                    }
                    else
                    {
                        <div class="card-img-wrapper bg-light d-flex align-items-center justify-content-center">
                            <i class="bi bi-cpu display-4 text-muted"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title text-truncate" title="@component.Name">@component.Name</h5>
                        <p class="card-text">
                            <span class="badge bg-primary">@component.Type</span>
                            <span class="badge bg-secondary">@component.Manufacturer</span>
                        </p>

                        @if (component.LowestPrice.HasValue)
                        {
                            <h4 class="text-success">
                                From €@component.LowestPrice.Value.ToString("N2")
                            </h4>
                        }

                        @if (component.AveragePrice.HasValue)
                        {
                            <p class="text-muted mb-1">
                                Avg: €@component.AveragePrice.Value.ToString("N2")
                            </p>
                        }

                        @if (component.Rating.HasValue)
                        {
                            <small class="text-muted">
                                <i class="bi bi-star-fill text-warning"></i> @component.Rating.Value.ToString("N1") (@component.ReviewCount reviews)
                            </small>
                        }
                    </div>
                    <div class="card-footer">
                        <a href="/component/@component.Id" class="btn btn-primary btn-sm w-100">
                            View Prices & Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .card-img-wrapper {
        height: 120px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

    .component-img {
        max-height: 100px;
        max-width: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
    }
</style>

