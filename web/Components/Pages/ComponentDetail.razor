@page "/component/{id:int}"
@using Domain.Entities
@using Domain.Enums
@using web.Services
@inject ComponentService ComponentService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(component?.Name ?? "Component Details")</PageTitle>

<div class="container py-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading component details...</p>
        </div>
    }
    else if (component == null)
    {
        <div class="alert alert-danger">
            <h4>Component Not Found</h4>
            <p>The component you're looking for doesn't exist.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/build/new")'>
                Back to Build Configurator
            </button>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/build/new">Build Configurator</a></li>
                <li class="breadcrumb-item active">@component.Type</li>
                <li class="breadcrumb-item active">@component.Name</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-md-5">
                <div class="card">
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(component.ImageUrl))
                        {
                            <div class="product-image-wrapper">
                                <img src="@component.ImageUrl"
                                     alt="@component.Name"
                                     class="product-image" />
                            </div>
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3"
                                 style="height: 180px;">
                                <i class="bi bi-image display-1 text-muted"></i>
                            </div>
                        }

                        <h2 class="mb-3">@component.Name</h2>

                        <div class="mb-3">
                            <span class="badge bg-primary fs-5">@component.Manufacturer</span>
                            <span class="badge bg-secondary fs-5">@component.Type</span>
                        </div>

                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h3 class="text-success mb-2">@component.LowestPrice?.ToString("C2")</h3>
                                <small class="text-muted">Lowest Price</small>
                                @if (component.AveragePrice.HasValue && component.AveragePrice != component.LowestPrice)
                                {
                                    <div class="mt-2">
                                        <small>Average: @component.AveragePrice?.ToString("C2")</small>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (component.Rating.HasValue || component.ReviewCount > 0)
                        {
                            <div class="mb-3">
                                <i class="bi bi-star-fill text-warning"></i>
                                <strong>@(component.Rating?.ToString("N1") ?? "N/A")</strong>
                                <span class="text-muted">(@component.ReviewCount reviews)</span>
                            </div>
                        }

                        <div class="d-grid gap-2">
                            <a href="https://geizhals.de/?fs=@Uri.EscapeDataString(component.Name)"
                               target="_blank"
                               class="btn btn-primary btn-lg">
                                <i class="bi bi-cart"></i> View on Geizhals
                            </a>
                            <button class="btn btn-outline-secondary" @onclick="GoBack">
                                <i class="bi bi-arrow-left"></i> Back to Selection
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Technical Specifications</h4>
                    </div>
                    <div class="card-body">

                        @if (component.CPUSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-cpu"></i> Processor Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th>Core Count</th>
                                        <td>@component.CPUSpec.Cores Cores</td>
                                    </tr>
                                    <tr>
                                        <th>Thread Count</th>
                                        <td>@component.CPUSpec.Threads Threads</td>
                                    </tr>
                                    <tr>
                                        <th>Base Clock</th>
                                        <td>@component.CPUSpec.BaseClock GHz</td>
                                    </tr>
                                    <tr>
                                        <th>Boost Clock</th>
                                        <td>@(component.CPUSpec.BoostClock.HasValue ? $"{component.CPUSpec.BoostClock} GHz" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th>TDP</th>
                                        <td>@component.CPUSpec.TDP W</td>
                                    </tr>
                                    <tr>
                                        <th>Integrated Graphics</th>
                                        <td>
                                            @if (component.CPUSpec.IntegratedGraphics)
                                            {
                                                <span class="badge bg-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        }

                        @if (component.GPUSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-gpu-card"></i> Graphics Card Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    @if (!string.IsNullOrEmpty(component.GPUSpec.Chipset))
                                    {
                                        <tr>
                                            <th>Chipset</th>
                                            <td>@component.GPUSpec.Chipset</td>
                                        </tr>
                                    }
                                    <tr>
                                        <th>Memory Size</th>
                                        <td>@component.GPUSpec.MemorySize GB</td>
                                    </tr>
                                    <tr>
                                        <th>Memory Type</th>
                                        <td>@component.GPUSpec.MemoryType</td>
                                    </tr>
                                    @if (component.GPUSpec.TDP.HasValue)
                                    {
                                        <tr>
                                            <th>TDP</th>
                                            <td>@component.GPUSpec.TDP W</td>
                                        </tr>
                                    }
                                    @if (component.GPUSpec.LengthMM.HasValue || component.GPUSpec.WidthMM.HasValue || component.GPUSpec.HeightMM.HasValue)
                                    {
                                        <tr>
                                            <th>Dimensions</th>
                                            <td>
                                                @(component.GPUSpec.LengthMM.HasValue ? $"{component.GPUSpec.LengthMM}mm (L)" : "")
                                                @(component.GPUSpec.WidthMM.HasValue ? $" × {component.GPUSpec.WidthMM}mm (W)" : "")
                                                @(component.GPUSpec.HeightMM.HasValue ? $" × {component.GPUSpec.HeightMM}mm (H)" : "")
                                            </td>
                                        </tr>
                                    }
                                    @if (component.GPUSpec.Aux6PinCount.HasValue || component.GPUSpec.Aux8PinCount.HasValue)
                                    {
                                        <tr>
                                            <th>Power Connectors</th>
                                            <td>
                                                @if (component.GPUSpec.Aux6PinCount.HasValue && component.GPUSpec.Aux6PinCount > 0)
                                                {
                                                    <span>@component.GPUSpec.Aux6PinCount × 6-pin</span>
                                                }
                                                @if (component.GPUSpec.Aux8PinCount.HasValue && component.GPUSpec.Aux8PinCount > 0)
                                                {
                                                    <span>@component.GPUSpec.Aux8PinCount × 8-pin</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (component.RAMSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-memory"></i> Memory Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th>Capacity</th>
                                        <td>@component.RAMSpec.Capacity GB (@component.RAMSpec.ModuleCount × @(component.RAMSpec.Capacity / Math.Max(component.RAMSpec.ModuleCount, 1)) GB)</td>
                                    </tr>
                                    <tr>
                                        <th>Type</th>
                                        <td>@(component.RAMSpec.Type ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th>Speed</th>
                                        <td>@component.RAMSpec.Speed MHz</td>
                                    </tr>
                                    <tr>
                                        <th>Module Count</th>
                                        <td>@component.RAMSpec.ModuleCount</td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(component.RAMSpec.Timings))
                                    {
                                        <tr>
                                            <th>Timings</th>
                                            <td>@component.RAMSpec.Timings</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @* Motherboard Specifications *@
                        @if (component.MotherboardSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-motherboard"></i> Motherboard Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.Socket))
                                    {
                                        <tr>
                                            <th>Socket</th>
                                            <td>@component.MotherboardSpec.Socket</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.Chipset))
                                    {
                                        <tr>
                                            <th>Chipset</th>
                                            <td>@component.MotherboardSpec.Chipset</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.FormFactor))
                                    {
                                        <tr>
                                            <th>Form Factor</th>
                                            <td>@component.MotherboardSpec.FormFactor</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.MemoryType))
                                    {
                                        <tr>
                                            <th>Memory Type</th>
                                            <td>@component.MotherboardSpec.MemoryType</td>
                                        </tr>
                                    }
                                    @if (component.MotherboardSpec.MemorySlots.HasValue)
                                    {
                                        <tr>
                                            <th>Memory Slots</th>
                                            <td>@component.MotherboardSpec.MemorySlots</td>
                                        </tr>
                                    }
                                    @if (component.MotherboardSpec.MaxMemoryCapacityGB.HasValue)
                                    {
                                        <tr>
                                            <th>Max Memory Capacity</th>
                                            <td>@component.MotherboardSpec.MaxMemoryCapacityGB GB</td>
                                        </tr>
                                    }
                                    @if (component.MotherboardSpec.MaxMemorySpeedMHz.HasValue)
                                    {
                                        <tr>
                                            <th>Max Memory Speed</th>
                                            <td>@component.MotherboardSpec.MaxMemorySpeedMHz MHz</td>
                                        </tr>
                                    }
                                    @if (component.MotherboardSpec.M2SlotCount.HasValue)
                                    {
                                        <tr>
                                            <th>M.2 Slots</th>
                                            <td>@component.MotherboardSpec.M2SlotCount</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.PCIeSlots))
                                    {
                                        <tr>
                                            <th>PCIe Slots</th>
                                            <td>@component.MotherboardSpec.PCIeSlots</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.MaxPCIeGeneration))
                                    {
                                        <tr>
                                            <th>Max PCIe Generation</th>
                                            <td>@component.MotherboardSpec.MaxPCIeGeneration</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.MotherboardSpec.PowerConnectors))
                                    {
                                        <tr>
                                            <th>Power Connectors</th>
                                            <td>@component.MotherboardSpec.PowerConnectors</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (component.StorageSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-device-hdd"></i> Storage Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th>Capacity</th>
                                        <td>
                                            @if (component.StorageSpec.Capacity >= 1000)
                                            {
                                                @($"{component.StorageSpec.Capacity / 1000.0:N1} TB")
                                            }
                                            else
                                            {
                                                @($"{component.StorageSpec.Capacity} GB")
                                            }
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(component.StorageSpec.Type))
                                    {
                                        <tr>
                                            <th>Type</th>
                                            <td>@component.StorageSpec.Type</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.StorageSpec.Interface))
                                    {
                                        <tr>
                                            <th>Interface</th>
                                            <td>@component.StorageSpec.Interface</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (component.PSUSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-lightning-charge"></i> Power Supply Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th>Wattage</th>
                                        <td>@component.PSUSpec.Wattage W</td>
                                    </tr>
                                    <tr>
                                        <th>Modular</th>
                                        <td>
                                            @if (component.PSUSpec.Modular)
                                            {
                                                <span class="badge bg-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(component.PSUSpec.EfficiencyRating))
                                    {
                                        <tr>
                                            <th>Efficiency Rating</th>
                                            <td>@component.PSUSpec.EfficiencyRating</td>
                                        </tr>
                                    }
                                    @if (component.PSUSpec.Aux6PinCount.HasValue)
                                    {
                                        <tr>
                                            <th>6-Pin Connectors</th>
                                            <td>@component.PSUSpec.Aux6PinCount</td>
                                        </tr>
                                    }
                                    @if (component.PSUSpec.SATAPowerCount.HasValue)
                                    {
                                        <tr>
                                            <th>SATA Power Connectors</th>
                                            <td>@component.PSUSpec.SATAPowerCount</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.PSUSpec.DimensionsMM))
                                    {
                                        <tr>
                                            <th>Dimensions</th>
                                            <td>@component.PSUSpec.DimensionsMM</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (component.CaseSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-pc-display"></i> Case Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    @if (!string.IsNullOrEmpty(component.CaseSpec.FormFactor))
                                    {
                                        <tr>
                                            <th>Form Factor</th>
                                            <td>@component.CaseSpec.FormFactor</td>
                                        </tr>
                                    }
                                    @if (component.CaseSpec.MaxGPULengthMM.HasValue)
                                    {
                                        <tr>
                                            <th>Max GPU Length</th>
                                            <td>@component.CaseSpec.MaxGPULengthMM mm</td>
                                        </tr>
                                    }
                                    @if (component.CaseSpec.MaxCoolerHeightMM.HasValue)
                                    {
                                        <tr>
                                            <th>Max Cooler Height</th>
                                            <td>@component.CaseSpec.MaxCoolerHeightMM mm</td>
                                        </tr>
                                    }
                                    @if (component.CaseSpec.BayCount35.HasValue || component.CaseSpec.BayCount25.HasValue)
                                    {
                                        <tr>
                                            <th>Drive Bays</th>
                                            <td>
                                                @if (component.CaseSpec.BayCount35.HasValue)
                                                {
                                                    <span>@component.CaseSpec.BayCount35 × 3.5"</span>
                                                }
                                                @if (component.CaseSpec.BayCount25.HasValue)
                                                {
                                                    <span> / @component.CaseSpec.BayCount25 × 2.5"</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.CaseSpec.ExpansionSlots))
                                    {
                                        <tr>
                                            <th>Expansion Slots</th>
                                            <td>@component.CaseSpec.ExpansionSlots</td>
                                        </tr>
                                    }
                                    <tr>
                                        <th>Front Panel USB</th>
                                        <td>
                                            @if (component.CaseSpec.HasUSBC)
                                            {
                                                <span class="badge bg-success me-1">USB-C</span>
                                            }
                                            @if (component.CaseSpec.HasUSB3)
                                            {
                                                <span class="badge bg-info">USB 3.0</span>
                                            }
                                            @if (!component.CaseSpec.HasUSBC && !component.CaseSpec.HasUSB3)
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Tempered Glass</th>
                                        <td>
                                            @if (component.CaseSpec.HasTemperedGlass)
                                            {
                                                <span class="badge bg-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (component.CaseSpec.VolumeLiters.HasValue)
                                    {
                                        <tr>
                                            <th>Volume</th>
                                            <td>@component.CaseSpec.VolumeLiters L</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(component.CaseSpec.DimensionsMM))
                                    {
                                        <tr>
                                            <th>Dimensions</th>
                                            <td>@component.CaseSpec.DimensionsMM</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @* CPU Cooler Specifications *@
                        @if (component.CPUCoolerSpec != null)
                        {
                            <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-fan"></i> CPU Cooler Details</h5>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th>Cooling Type</th>
                                        <td>
                                            @if (component.CPUCoolerSpec.IsLiquidCooled)
                                            {
                                                <span class="badge bg-info">Liquid / AIO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Air Cooler</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(component.CPUCoolerSpec.SocketCompatibility))
                                    {
                                        <tr>
                                            <th>Socket Compatibility</th>
                                            <td>@component.CPUCoolerSpec.SocketCompatibility</td>
                                        </tr>
                                    }
                                    @if (component.CPUCoolerSpec.MaxTDP.HasValue)
                                    {
                                        <tr>
                                            <th>Max TDP</th>
                                            <td>@component.CPUCoolerSpec.MaxTDP W</td>
                                        </tr>
                                    }
                                    @if (component.CPUCoolerSpec.HeightMM.HasValue)
                                    {
                                        <tr>
                                            <th>Height</th>
                                            <td>@component.CPUCoolerSpec.HeightMM mm</td>
                                        </tr>
                                    }
                                    @if (component.CPUCoolerSpec.FanCount.HasValue)
                                    {
                                        <tr>
                                            <th>Fan Count</th>
                                            <td>@component.CPUCoolerSpec.FanCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @* If no specific specs are available *@
                        @if (component.CPUSpec == null && component.GPUSpec == null &&
                                            component.RAMSpec == null && component.StorageSpec == null &&
                                            component.PSUSpec == null && component.MotherboardSpec == null &&
                                            component.CaseSpec == null && component.CPUCoolerSpec == null)
                        {
                            <div class="alert alert-info">
                                <p class="mb-0">Detailed specifications are not available for this component yet.</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Additional Information</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th>Component ID</th>
                                    <td>@component.Id</td>
                                </tr>
                                <tr>
                                    <th>Quality Score</th>
                                    <td>@component.QualityScore.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th>Offer Count</th>
                                    <td>@component.OfferCount</td>
                                </tr>
                                <tr>
                                    <th>Qualified</th>
                                    <td>
                                        @if (component.IsQualified)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">No</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Last Updated</th>
                                    <td>@(component.LastUpdated?.ToString("dd.MM.yyyy HH:mm") ?? "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .product-image-wrapper {
        width: 180px;
        height: 180px;
        margin: 0 auto;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>

