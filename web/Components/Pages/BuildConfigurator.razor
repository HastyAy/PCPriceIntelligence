@page "/build/new"
@page "/build/edit/{BuildId:int}"
@using Domain.Entities
@using Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using web.Services
@inject ComponentService ComponentService
@inject BuildService BuildService
@inject GeminiService GeminiService
@inject CompatibilityService compatibilityService
@inject NavigationManager Navigation
@inject ILogger<BuildConfigurator> _logger
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@(IsEditMode ? "Edit Build" : "Build Your PC")</PageTitle>

@if (showSuccessMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>@successMessage</strong>
        <button type="button" class="btn-close" @onclick="() => showSuccessMessage = false"></button>
    </div>
}

<div class="container py-4">
    <h1>@(IsEditMode ? "Edit Your Build" : "Build Your Custom PC")</h1>
    <p class="lead">Select components one by one, then check compatibility</p>

    <div class="row mt-4">
        <!-- Component Selection Slots -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Your Build</h4>
                </div>
                <div class="card-body">
                    @foreach (var type in componentTypes)
                    {
                        <div class="component-slot mb-3 p-3 border rounded @(selectedComponents.ContainsKey(type) ? "bg-light" : "")">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <strong>@GetTypeLabel(type)</strong>
                                </div>
                                <div class="col-md-6">
                                    @if (selectedComponents.ContainsKey(type))
                                    {
                                        <div>
                                            <div>@selectedComponents[type].Name</div>
                                            <small class="text-muted">@selectedComponents[type].LowestPrice?.ToString("C2")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not selected</span>
                                    }
                                </div>
                                <div class="col-md-3 text-end">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBrowser(type)">
                                        @(selectedComponents.ContainsKey(type) ? "Change" : "Select")
                                    </button>
                                    @if (selectedComponents.ContainsKey(type))
                                    {
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => RemoveComponent(type)">
                                            ✕
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" @onclick="CheckCompatibility" disabled="@(!HasMinimumComponents || isChecking)">
                    @if (isChecking && !isAIChecking)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-circle"></i> Quick Check
                </button>
                <button class="btn btn-success" @onclick="AskAIForAnalysis" disabled="@(!HasMinimumComponents || isAIChecking)">
                    @if (isAIChecking)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-robot"></i> AI Analysis
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearBuild">
                    <i class="bi bi-trash"></i> Clear All
                </button>
            </div>
        </div>

        <!-- Summary Sidebar -->
        <div class="col-md-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Summary</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Components:</strong> @selectedComponents.Count / 8
                        <div class="progress mt-1" style="height: 8px;">
                            <div class="progress-bar" style="width: @(selectedComponents.Count * 12.5)%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>Total Price:</strong>
                        <h3 class="text-primary">@TotalPrice.ToString("C2")</h3>
                    </div>

                    @if (EstimatedWattage > 0)
                    {
                        <div class="mb-3">
                            <strong>Est. Power Draw:</strong>
                            <span class="badge bg-info">~@EstimatedWattage W</span>
                        </div>
                    }

                    <div class="mb-3">
                        <strong>Required:</strong>
                        <ul class="small mb-0 list-unstyled">
                            <li class="@(selectedComponents.ContainsKey(ComponentType.CPU) ? "text-success" : "text-danger")">
                                @(selectedComponents.ContainsKey(ComponentType.CPU) ? "✓" : "✗") CPU
                            </li>
                            <li class="@(selectedComponents.ContainsKey(ComponentType.Motherboard) ? "text-success" : "text-danger")">
                                @(selectedComponents.ContainsKey(ComponentType.Motherboard) ? "✓" : "✗") Motherboard
                            </li>
                            <li class="@(selectedComponents.ContainsKey(ComponentType.RAM) ? "text-success" : "text-danger")">
                                @(selectedComponents.ContainsKey(ComponentType.RAM) ? "✓" : "✗") RAM
                            </li>
                            <li class="@(selectedComponents.ContainsKey(ComponentType.PSU) ? "text-success" : "text-danger")">
                                @(selectedComponents.ContainsKey(ComponentType.PSU) ? "✓" : "✗") PSU
                            </li>
                        </ul>
                    </div>

                    <hr />

                    <!-- Save Button - Always visible when components selected -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" @onclick="OpenSaveDialog" 
                                disabled="@(!HasMinimumComponents || isSaving)">
                            <i class="bi bi-save"></i> @(IsEditMode ? "Update Build" : "Save Build")
                        </button>
                        @if (selectedComponents.Any())
                        {
                            <a href="/my-builds" class="btn btn-outline-secondary">
                                <i class="bi bi-list"></i> My Builds
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Component Browser Modal -->
    @if (showBrowser)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Select @GetTypeLabel(currentBrowsingType)</h5>
                        <button type="button" class="btn-close" @onclick="CloseBrowser"></button>
                    </div>
                    
                    <!-- Search and Filter Section -->
                    <div class="modal-header bg-light border-top">
                        <div class="w-100">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input type="text" 
                                           class="form-control" 
                                           placeholder="🔍 Search by name, manufacturer..." 
                                           @bind="searchQuery"
                                           @bind:event="oninput"
                                           @onkeyup="ApplyFilters" />
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select" @bind="sortOption" @bind:after="ApplyFilters">
                                        <option value="quality">Best Quality</option>
                                        <option value="price">Lowest Price</option>
                                        <option value="rating">Best Rating</option>
                                        <option value="offers">Most Offers</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select" @bind="manufacturerFilter" @bind:after="ApplyFilters">
                                        <option value="">All Manufacturers</option>
                                        @foreach (var manufacturer in GetAvailableManufacturers())
                                        {
                                            <option value="@manufacturer">@manufacturer</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted">Found @filteredComponents.Count components</small>
                            </div>
                        </div>
                    </div>

                    <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                        @if (isLoadingComponents)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary"></div>
                                <p class="mt-2">Loading components...</p>
                            </div>
                        }
                        else if (filteredComponents.Any())
                        {
                            <div class="row">
                                @foreach (var comp in filteredComponents.Take(50))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100 component-card" @onclick="() => SelectComponent(comp)" style="cursor: pointer;">
                                            <div class="card-body">
                                                <div class="d-flex">
                                                    @if (!string.IsNullOrEmpty(comp.ImageUrl))
                                                    {
                                                        <img src="@comp.ImageUrl" alt="@comp.Name" 
                                                             style="width: 60px; height: 60px; object-fit: contain;" class="me-3" />
                                                    }
                                                    <div class="flex-grow-1">
                                                        <h6 class="card-title mb-1">@comp.Name</h6>
                                                        <small class="text-muted">@comp.Manufacturer</small>
                                                        <div class="mt-2">
                                                            <span class="badge bg-success">@comp.LowestPrice?.ToString("C2")</span>
                                                            @if (comp.Rating.HasValue)
                                                            {
                                                                <span class="badge bg-warning text-dark ms-1">
                                                                    <i class="bi bi-star-fill"></i> @comp.Rating.Value.ToString("N1")
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                No components found matching your criteria.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Quick Compatibility Results -->
    @if (compatibilityResult != null)
    {
        <div class="mt-4">
            <div class="card">
                <div class="card-header @(compatibilityResult.Compatible ? "bg-success" : "bg-warning") text-white">
                    <h4 class="mb-0">
                        @if (compatibilityResult.Compatible)
                        {
                            <i class="bi bi-check-circle-fill"></i> <span>Compatible Build</span>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle-fill"></i> <span>Compatibility Issues</span>
                        }
                    </h4>
                </div>
                <div class="card-body">
                    @if (compatibilityResult.Errors?.Any() == true)
                    {
                        <div class="alert alert-danger">
                            <h6><i class="bi bi-x-circle"></i> Errors:</h6>
                            <ul class="mb-0">
                                @foreach (var error in compatibilityResult.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (compatibilityResult.Warnings?.Any() == true)
                    {
                        <div class="alert alert-warning">
                            <h6><i class="bi bi-exclamation-triangle"></i> Warnings:</h6>
                            <ul class="mb-0">
                                @foreach (var warning in compatibilityResult.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (compatibilityResult.Recommendations?.Any() == true)
                    {
                        <div class="alert alert-info">
                            <h6><i class="bi bi-lightbulb"></i> Recommendations:</h6>
                            <ul class="mb-0">
                                @foreach (var rec in compatibilityResult.Recommendations)
                                {
                                    <li>@rec</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (compatibilityResult.Compatible && !compatibilityResult.Errors?.Any() == true)
                    {
                        <div class="alert alert-success mb-0">
                            <h5 class="mb-0"><i class="bi bi-check-lg"></i> All selected components work together!</h5>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- AI Analysis Results -->
    @if (aiAnalysisResult != null)
    {
        <div class="mt-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-robot"></i> AI Build Analysis</h4>
                </div>
                <div class="card-body">
                    <!-- Overall Score -->
                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            <div class="display-4 @GetScoreColor(aiAnalysisResult.OverallScore)">
                                @aiAnalysisResult.OverallScore/100
                            </div>
                            <small class="text-muted">Overall Score</small>
                        </div>
                        <div class="col-md-8">
                            <h5>Build Summary</h5>
                            <p>@aiAnalysisResult.Summary</p>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Compatibility Check -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 @(aiAnalysisResult.IsCompatible ? "border-success" : "border-danger")">
                                <div class="card-header @(aiAnalysisResult.IsCompatible ? "bg-success" : "bg-danger") text-white">
                                    <h6 class="mb-0">
                                        @(aiAnalysisResult.IsCompatible ? "✓ Compatible" : "✗ Compatibility Issues")
                                    </h6>
                                </div>
                                <div class="card-body">
                                    @if (aiAnalysisResult.CompatibilityIssues?.Any() == true)
                                    {
                                        <ul class="small mb-0">
                                            @foreach (var issue in aiAnalysisResult.CompatibilityIssues)
                                            {
                                                <li class="text-danger">@issue</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-success mb-0">All components are compatible!</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Bottleneck Analysis -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-header bg-info text-white">
                                    <h6 class="mb-0"><i class="bi bi-speedometer2"></i> Bottleneck Analysis</h6>
                                </div>
                                <div class="card-body">
                                    @if (aiAnalysisResult.Bottlenecks?.Any() == true)
                                    {
                                        <ul class="small mb-0">
                                            @foreach (var bottleneck in aiAnalysisResult.Bottlenecks)
                                            {
                                                <li>@bottleneck</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-success mb-0">No significant bottlenecks detected!</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Performance Estimates -->
                    @if (aiAnalysisResult.PerformanceEstimates != null)
                    {
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0"><i class="bi bi-graph-up"></i> Performance Estimates</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @if (!string.IsNullOrEmpty(aiAnalysisResult.PerformanceEstimates.Gaming1080p))
                                    {
                                        <div class="col-md-4">
                                            <strong>1080p Gaming:</strong>
                                            <p class="mb-1">@aiAnalysisResult.PerformanceEstimates.Gaming1080p</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(aiAnalysisResult.PerformanceEstimates.Gaming1440p))
                                    {
                                        <div class="col-md-4">
                                            <strong>1440p Gaming:</strong>
                                            <p class="mb-1">@aiAnalysisResult.PerformanceEstimates.Gaming1440p</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(aiAnalysisResult.PerformanceEstimates.Gaming4K))
                                    {
                                        <div class="col-md-4">
                                            <strong>4K Gaming:</strong>
                                            <p class="mb-1">@aiAnalysisResult.PerformanceEstimates.Gaming4K</p>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(aiAnalysisResult.PerformanceEstimates.Productivity))
                                {
                                    <div class="mt-2">
                                        <strong>Productivity:</strong> @aiAnalysisResult.PerformanceEstimates.Productivity
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Tips -->
                    @if (aiAnalysisResult.Tips?.Any() == true)
                    {
                        <div class="card mb-3 border-warning">
                            <div class="card-header bg-warning">
                                <h6 class="mb-0"><i class="bi bi-lightbulb-fill"></i> Pro Tips</h6>
                            </div>
                            <div class="card-body">
                                <ul class="mb-0">
                                    @foreach (var tip in aiAnalysisResult.Tips)
                                    {
                                        <li>@tip</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <!-- Upgrade Recommendations -->
                    @if (aiAnalysisResult.UpgradeRecommendations?.Any() == true)
                    {
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-arrow-up-circle"></i> Upgrade Recommendations</h6>
                            </div>
                            <div class="card-body">
                                <ul class="mb-0">
                                    @foreach (var upgrade in aiAnalysisResult.UpgradeRecommendations)
                                    {
                                        <li>@upgrade</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Product Table / Shopping List -->
    @if (selectedComponents.Any())
    {
        <div class="card mt-4">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0"><i class="bi bi-cart3"></i> Shopping List</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Type</th>
                                <th>Product</th>
                                <th>Manufacturer</th>
                                <th class="text-end">Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in selectedComponents)
                            {
                                <tr>
                                    <td><strong>@GetTypeLabel(kvp.Key)</strong></td>
                                    <td>@kvp.Value.Name</td>
                                    <td><span class="badge bg-secondary">@kvp.Value.Manufacturer</span></td>
                                    <td class="text-end">
                                        <span class="badge bg-success">@kvp.Value.LowestPrice?.ToString("C2")</span>
                                    </td>
                                    <td>
                                        <a href="https://geizhals.de/?fs=@Uri.EscapeDataString(kvp.Value.Name)" 
                                           target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-box-arrow-up-right"></i> Buy
                                        </a>
                                    </td>
                                </tr>
                            }
                            <tr class="table-primary fw-bold">
                                <td colspan="3">Total</td>
                                <td class="text-end">
                                    <span class="badge bg-primary fs-6">@TotalPrice.ToString("C2")</span>
                                </td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Save Dialog Modal -->
    @if (showSaveDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(IsEditMode ? "Update Your Build" : "Save Your Build")</h5>
                        <button type="button" class="btn-close" @onclick="CloseSaveDialog"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Build Name *</label>
                            <input type="text" class="form-control" @bind="buildName" placeholder="My Gaming Build" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notes (Optional)</label>
                            <textarea class="form-control" @bind="buildNotes" rows="3" placeholder="Build notes..."></textarea>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-6">
                                <strong>Components:</strong> @selectedComponents.Count
                            </div>
                            <div class="col-6 text-end">
                                <strong>Total:</strong> @TotalPrice.ToString("C2")
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveBuild" 
                                disabled="@(isSaving || string.IsNullOrWhiteSpace(buildName))">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @(IsEditMode ? "Update Build" : "Save Build")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .component-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
    }
</style>