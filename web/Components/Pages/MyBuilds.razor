@page "/my-builds"
@using Domain.Entities
@using Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using web.Services
@inject BuildService BuildService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>My Builds</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My PC Builds</h1>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/build/new")'>
            ➕ New Build
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading your builds...</p>
        </div>
    }
    else if (!builds.Any())
    {
        <div class="alert alert-info">
            <h4>No builds yet!</h4>
            <p>Start creating your first PC build by clicking the "New Build" button above.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var build in builds)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title">@build.Name</h5>
                                <span class="badge @(build.IsPublic ? "bg-success" : "bg-warning")">
                                    @(build.IsPublic ? "Public" : "Private")
                                </span>
                            </div>
                            <p class="text-muted small">
                                <i class="bi bi-calendar"></i> @build.CreatedAt.ToString("MMM dd, yyyy")
                            </p>

                            <div class="my-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <strong>Total Price:</strong>
                                    <span class="badge bg-success fs-6">@build.TotalPrice.ToString("C2")</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(build.Notes))
                            {
                                <p class="card-text small text-muted">
                                    @(build.Notes.Length > 100 ? build.Notes.Substring(0, 100) + "..." : build.Notes)
                                </p>
                            }

                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-sm btn-primary flex-fill"
                                        @onclick="() => ViewBuild(build.Id)">
                                    <i class="bi bi-eye"></i> View
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(build)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDeleteConfirm && buildToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@buildToDelete.Name</strong>?</p>
                    <p class="text-danger">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteBuild" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important;
        }
</style>

